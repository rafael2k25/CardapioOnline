@{
    ViewData["Title"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard">

    <!-- CABEÇALHO -->
    <section class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Bem-vindo ao painel administrativo do Cardápio.</p>
        </div>

        <div class="header-actions">
            <span class="status-system">
                Sistema operacional
            </span>
        </div>
    </section>

    <!-- INDICADORES -->
    <section class="dashboard-cards">

        <div class="dashboard-card">
            <div class="card-info">
                <span>Total de produtos</span>
                <h2 id="totalProdutos">0</h2>
                <p>Produtos cadastrados</p>
            </div>
            <div class="card-icon">
                <i class="bi bi-cup-straw"></i>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-info">
                <span>Categorias</span>
                <h2 id="totalCategorias">0</h2>
                <p>Categorias cadastradas</p>
            </div>
            <div class="card-icon">
                <i class="bi bi-grid"></i>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-info">
                <span>Produtos disponíveis</span>
                <h2 id="produtosDisponiveis">0</h2>
                <p>Disponíveis para consulta</p>
            </div>
            <div class="card-icon">
                <i class="bi bi-check-circle"></i>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-info">
                <span>Produtos indisponíveis</span>
                <h2 id="produtosIndisponiveis">0</h2>
                <p>Fora de disponibilidade</p>
            </div>
            <div class="card-icon">
                <i class="bi bi-exclamation-circle"></i>
            </div>
        </div>

    </section>

    <!-- ACESSO RÁPIDO -->
    <section class="quick-actions">

        <div class="section-header">
            <h2>Acesso rápido</h2>
            <p>Gerencie as informações da sua loja.</p>
        </div>

        <div class="quick-actions-grid">

            <a href="#" class="action-card">
                <i class="bi bi-plus-circle"></i>
                <div>
                    <h3>Adicionar produto</h3>
                    <p>Cadastrar uma nova bebida.</p>
                </div>
            </a>

            <a asp-controller="Categoria" asp-action="Index" class="action-card">
                <i class="bi bi-tags"></i>
                <div>
                    <h3>Gerenciar categorias</h3>
                    <p>Organizar os produtos da loja.</p>
                </div>
            </a>

            <a asp-controller="Produto" asp-action="Index" class="action-card">
                <i class="bi bi-box-seam"></i>
                <div>
                    <h3>Gerenciar produtos</h3>
                    <p>Editar preços e informações.</p>
                </div>
            </a>

            <a href="#" class="action-card">
                <i class="bi bi-eye"></i>
                <div>
                    <h3>Visualizar cardápio</h3>
                    <p>Consultar a versão pública.</p>
                </div>
            </a>

        </div>

    </section>

    <!-- PRODUTOS RECENTES -->
    <section class="recent-products">

        <div class="section-header">
            <div>
                <h2>Produtos recentes</h2>
                <p>Últimos produtos cadastrados no sistema.</p>
            </div>

            <a href="#" class="view-all">
                Ver todos
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="table-container">

            <table>
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Preço</th>
                        <th>Disponibilidade</th>
                    </tr>
                </thead>

                <tbody id="tabelaProdutosRecentes">
                    <tr>
                        <td colspan="4">Carregando produtos...</td>
                    </tr>
                </tbody>
            </table>

        </div>

    </section>

</div>
